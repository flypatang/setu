; Engine configuration file. See docs/DESIGN.md §8 and §10.
config_version=5

[application]
config/name="Setu — The Bridge to Lanka"
config/version="0.1.0-alpha.4"
run/main_scene="res://main.tscn"
run/max_fps=60
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Sound="*res://core/sound.gd"

GameState="*res://core/game_state.gd"
Locale="*res://core/locale.gd"

[debug]
gdscript/warnings/exclude_addons=true
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/inferred_declaration=1

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[editor_plugins]
enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[internationalization]
locale/fallback="en"

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="forward_plus"
